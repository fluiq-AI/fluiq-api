# Copy to .env.development and fill in the three secrets at the top.
#
# Almost nothing in config.py has a fallback, and a few settings are wrapped in
# int()/float(), so a missing value raises TypeError at import rather than
# failing later with a useful message. That is why this file lists everything
# rather than only the interesting parts.
#
# Defaults below match docker-compose.yml.

# ---------- Secrets: no safe default, set these ----------
JWT_SECRET=change-me-to-a-long-random-string
AUDIT_HMAC_SECRET=change-me-to-another-long-random-string
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Auth ----------
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
PASSWORD_RESET_OTP_LENGTH=6
PASSWORD_RESET_EXPIRE_MINUTES=15

# ---------- Postgres ----------
POSTGRES_DSN=postgresql://fluiq:fluiq@postgres:5432/fluiq
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_SSL_CA_FILE=
POSTGRES_USER_TABLE=users
POSTGRES_ORG_TABLE=organizations
POSTGRES_REVOKED_TOKEN_TABLE=revoked_refresh_tokens
POSTGRES_PASSWORD_RESET_TABLE=password_resets

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=fluiq
CLICKHOUSE_TRACE_TABLE=fluiq.traces
CLICKHOUSE_TRACE_COSTS_TABLE=fluiq.trace_costs
CLICKHOUSE_TRACE_TAGS_TABLE=fluiq.trace_tags
CLICKHOUSE_EVALUATIONS_TABLE=fluiq.evaluations
CLICKHOUSE_SECURITY_TABLE=fluiq.security_scans
CLICKHOUSE_AUDIT_TABLE=audit_log

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TRACE_TOPIC=fluiq.traces
KAFKA_TRACE_PERSISTED_TOPIC=fluiq.traces.persisted
KAFKA_EVAL_TOPIC=fluiq.eval
KAFKA_SECURITY_TOPIC=fluiq.security
KAFKA_SECURITY_REPLY_TOPIC=fluiq.security.reply
KAFKA_PLAYGROUND_REPLY_TOPIC=fluiq.playground.reply
KAFKA_SECURITY_CHECK_TIMEOUT=8.0
KAFKA_PLAYGROUND_CHECK_TIMEOUT=30.0

# ---------- Redis: only used by fluiq.optimize() caching ----------
REDIS_URL=redis://redis:6379/0

# ---------- Web ----------
API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URLS=http://localhost:3000

# ---------- Evaluation ----------
EVAL_DEFAULT_THRESHOLD=0.7

# ---------- Credential encryption ----------
# Production used AWS KMS. "local" keeps provider credentials encrypted with a
# key from this file instead, which is fine for development and not for anything
# else.
CREDENTIAL_ENCRYPTION_BACKEND=local
CREDENTIAL_ENCRYPTION_LOCAL_KEY=change-me-32-byte-urlsafe-base64-key=
CREDENTIAL_KMS_KEY_ID=

# ---------- Optional: email/password auth works without these ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Optional: outbound email (contact form, password reset) ----------
RESEND_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ---------- Optional: legacy deploy hook, unused in the open-source stack ----------
RENDER_DEPLOY_HOOK_URL=
